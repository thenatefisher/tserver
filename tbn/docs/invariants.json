{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "name": "TBN System Invariants",
  "version": "2.0.0",
  "network": {
    "serverPort": 4000,
    "udpDiscoveryPort": 4001,
    "localClientPort": 3000,
    "udpProbeMessage": "TBN_DISCOVER",
    "udpBeaconType": "TBN_SERVER_BEACON",
    "httpPingEndpoint": "/ping",
    "simulationFrequencyHz": 30,
    "simulationTimestepSeconds": 0.03333333333,
    "stateBroadcastFrequencyHz": 15,
    "stateBroadcastTiming": "approximate"
  },
  "coordinates": {
    "bodyFrame": {
      "handedness": "right",
      "forward": "+X",
      "left": "+Y",
      "up": "+Z",
      "rollAxis": "+X",
      "pitchAxis": "+Y",
      "yawAxis": "+Z"
    },
    "worldFrame": {
      "east": "+X",
      "altitude": "+Y",
      "south": "+Z"
    },
    "grounding": {
      "maxPlaneDeviation": 0.01,
      "minClearance": 0.0,
      "maxClearance": 0.1,
      "contactPlaneZ": 0.0
    },
    "clientRotation": {
      "representation": "Euler",
      "unit": "radians",
      "order": "XYZ",
      "xAxis": "roll",
      "yAxis": "pitch",
      "zAxis": "yaw"
    },
    "bodyToWorldAtZeroHeading": {
      "x": "x",
      "y": "z",
      "z": "-y"
    }
  },
  "geometryLimits": {
    "hitbox": {
      "x": 2,
      "y": 2,
      "z": 2
    },
    "maxVisualSize": {
      "x": 3,
      "y": 3,
      "z": 3
    },
    "maxPolygonTriangles": 5000,
    "maxGlbBytes": 16777216,
    "supportedGlbVersions": [
      2
    ],
    "glbEncoding": "base64",
    "actorLocalBounds": {
      "min": {
        "x": -1.5,
        "y": -1.5,
        "z": 0
      },
      "max": {
        "x": 1.5,
        "y": 1.5,
        "z": 3
      }
    },
    "projectileOriginsUseFullActorCube": true,
    "hitboxCenter": {
      "x": 0,
      "y": 0,
      "z": 0
    },
    "hitboxEnforcedBy": "server",
    "minMeshVolumeCubicMeters": 1,
    "meshVolumeEnforcedBy": "server"
  },
  "terrain": {
    "schema": "tbn/schemas/world.schema.json#/properties/terrain",
    "type": "dted",
    "order": "row-major",
    "columnAxis": "+X",
    "rowAxis": "+Z",
    "elevationAxis": "+Y",
    "spacingUnits": "meters",
    "resolutionConfigurable": true,
    "elevationScale": 0.1,
    "storedElevationType": "integer",
    "boundaryConvention": "half-open",
    "columnsFormula": "ceil(width / spacing.x)",
    "rowsFormula": "ceil(depth / spacing.z)",
    "depthMapLengthFormula": "rows * columns",
    "example": {
      "width": 1000,
      "depth": 1000,
      "spacing": {
        "x": 0.25,
        "z": 0.25
      },
      "columns": 4000,
      "rows": 4000,
      "sampleCount": 16000000
    },
    "collisionTopology": "triangles (a,c,b) and (b,c,d); last row/column extended to far boundary",
    "replacementPolicy": "fixedDuringGameplay; adminFlattenOrPresetReplacesSnapshotAndColliders",
    "presetContract": "tbn/schemas/world.schema.json#/properties/terrain/properties/preset"
  },
  "input": {
    "actionSchema": "tbn/schemas/actions.schema.json",
    "protocolVersion": 2,
    "coordinateFrame": "body",
    "semantics": "normalizedControlEffort",
    "frame": "completeHeldState",
    "sequence": "strictlyIncreasingPerConnectionAndSession",
    "inputTimeoutSeconds": 0.25,
    "jump": "groundedRisingEdge",
    "unsupportedControls": "noActuation",
    "standardGravityMetersPerSecondSquared": 9.81
  },
  "actorRegistration": {
    "schema": "tbn/schemas/actor.schema.json",
    "attributesGeneratedAt": "buildTimeBeforeExecutionOrConnection",
    "submissionOrder": [
      "playerServerRegistration",
      "actorCharacteristicsSubmission",
      "gameSessionJoin"
    ],
    "attributesField": "physicsProfile",
    "weaponHardpointsField": "mesh.metadata.projectileOrigins",
    "hardpointCoordinateFrame": "body",
    "meshSchema": "tbn/schemas/mesh.schema.json",
    "requiredOnEveryConnection": true,
    "nameMaxLength": 30,
    "requiredPhysicsAttributes": [
      "maxSpeed",
      "controller"
    ],
    "maxSpeedMinimum": 1,
    "maxSpeedMaximum": 100,
    "hardpointIdMaxLength": 8,
    "buildArtifacts": {
      "glbPath": "./actor.glb",
      "jsonPath": "./actor.json",
      "generatedAt": "buildTimeBeforeExecutionOrConnection",
      "defaultActorWhenUndescribed": "simple stick man",
      "embeddedGlbField": "mesh.glb",
      "embeddedGlbEncoding": "base64",
      "embeddedGlbMustMatchFileBytes": true
    },
    "propertySelection": {
      "at": "buildTime",
      "userSelectable": [
        "maxSpeed",
        "controller"
      ],
      "units": {
        "maxSpeed": "m/s",
        "controller": "enum"
      },
      "tradeoffsEnabled": false,
      "additionalPropertiesAllowed": false,
      "futureExpansion": "Additional parameters and tradeoffs require explicit schema and contract updates."
    }
  },
  "world": {
    "schema": "tbn/schemas/world.schema.json",
    "sizeMeters": {
      "x": 1000,
      "y": 1000,
      "z": 1000
    },
    "delivery": [
      "onConnection",
      "onRequest",
      "onAdminTerrainFlatten"
    ]
  },
  "gameState": {
    "schema": "tbn/schemas/state.schema.json",
    "snapshot": "full",
    "includesReceivingPlayer": true,
    "hitEvents": "sincePreviousBroadcast",
    "hitEventDeduplicationKey": "id",
    "positionFrame": "world",
    "velocityUnits": "m/s",
    "orientationRepresentation": "Euler",
    "orientationUnits": "radians",
    "orientationOrder": "XYZ"
  },
  "physics": {
    "engine": "Rapier",
    "density": 1,
    "restitution": 0.25,
    "fixedSubstepSeconds": 0.008333333333333333,
    "maxAngularSpeed": 3,
    "forwardAcceleration": 29.43,
    "lateralAcceleration": 9.81,
    "verticalAcceleration": 49.05,
    "angularAcceleration": 1,
    "jumpSpeed": 6,
    "brakeDeceleration": 20,
    "rollingDeceleration": 0.6,
    "lateralGrip": 30,
    "attitudeStiffness": 35,
    "attitudeDamping": 10,
    "hoverHeight": 1.5,
    "hoverStiffness": 20,
    "hoverDamping": 8,
    "waterLevel": 0,
    "buoyancyStiffness": 30,
    "buoyancyDamping": 6,
    "controllerSchema": "tbn/schemas/actor.schema.json#/properties/physicsProfile/properties/controller",
    "coastDeceleration": 6,
    "steeringReverseThreshold": 0.1,
    "aircraftModel": "assisted-flight-v1",
    "aircraftVelocityResponse": 1.2,
    "aircraftAcceleration": 15,
    "aircraftAngularRate": 0.8,
    "aircraftAngularAcceleration": 2,
    "aircraftRateResponse": 0.25,
    "aircraftAutoLevel": true,
    "aircraftLevelGain": 1.5,
    "aircraftBankTurnRate": 0.6,
    "aircraftTakeoffVerticalSpeed": 0.5,
    "aircraftTakeoffSpeed": 5
  }
}
