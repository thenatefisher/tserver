{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SystemMessages",
  "type": "array",
  "maxItems": 20,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": ["id", "text"],
    "properties": {
      "id": { "type": "string", "minLength": 1, "maxLength": 128 },
      "text": { "type": "string", "minLength": 1, "maxLength": 2000 }
    }
  }
}
