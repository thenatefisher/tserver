{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ClientControlFrameV2",
  "description": "Complete held-state normalized control effort, NOT acceleration, velocity or pose. Body +X forward, +Y left, +Z up; rotate X roll, Y pitch, Z yaw. Send at 30 Hz, increasing sequence per connection/session. Old/duplicate sequences are rejected; controls neutralize after 250 ms without a newer frame. Jump is rising-edge triggered while grounded. Unsupported controls produce no actuation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "sequence",
    "move",
    "rotate",
    "brake",
    "jump"
  ],
  "properties": {
    "protocolVersion": {
      "const": 2
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "move": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "z": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "rotate": {
      "type": "object",
      "required": [
        "x",
        "y",
        "z"
      ],
      "additionalProperties": false,
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "y": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "z": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        }
      }
    },
    "brake": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "jump": {
      "type": "boolean"
    }
  }
}
